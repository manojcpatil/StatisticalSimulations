rbivar_norm=function(samp_size,mux,muy,sig_x,sig_y,rho_xy){
rbivar_norm=numeric(2)
for(i in 1: samp_size){
x=rnorm(1,mux,sig_x)
y_x=rnorm(1,muy+rho_xy*sig_y/sig_x*(x-mux))
rbivar_norm=rbind(c(x,y_x))
}
return(rbivar_norm)
}
print(rbivar_norm(samp_size=5,mux=3,muy=5,sig_x=1.2,sig_y=1.5,rho_xy=0.6))
rbivar_norm=function(samp_size,mux,muy,sig_x,sig_y,rho_xy){
rbivar_norm=matrix(numeric(samp_size*2),nrow=samp_size)
for(i in 1: samp_size){
x=rnorm(1,mux,sig_x)
y_x=rnorm(1,muy+rho_xy*sig_y/sig_x*(x-mux))
rbivar_norm[i,]=c(x,y_x)
}
return(rbivar_norm)
}
print(rbivar_norm(samp_size=5,mux=3,muy=5,sig_x=1.2,sig_y=1.5,rho_xy=0.6))
rbivar_norm=function(samp_size,mux,muy,sig_x,sig_y,rho_xy){
rbivar_norm=matrix(numeric(samp_size*2),nrow=samp_size)
for(i in 1: samp_size){
x=rnorm(1,mux,sig_x)
y_x=rnorm(1,muy+rho_xy*sig_y/sig_x*(x-mux))
rbivar_norm[i,]=c(x,y_x)
}
return(rbivar_norm)
}
samples=rbivar_norm(samp_size=5,mux=3,muy=5,sig_x=1.2,sig_y=1.5,rho_xy=0.6)
