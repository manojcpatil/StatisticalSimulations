L=chol(Sig_M)
W=matrix(rnorm(samp_size*length(Mu)),nrow=samp_size)
X=W*0
for(i in 1: samp_size){
X[i,]=Mu+t(L)%*%W[i,]
}
return(X)
}
samples=rbivar_norm_chol(samp_size=500,Mu=c(3,5),Sig_M=matrix(c(1.64,-0.4,-0.4,6.4),nrow=2))
colMeans(samples)
cov(samples)
