rbivar_norm_chol=function(samp_size,Mu,Sig_M){
L=chol(Sig_M)
W=matrix(rnorm(samp_size*length(Mu)),nrow=samp_size)
X=W*0
for(i in 1: nrow(W)){
X[i,]=t(Mu)+L%*%t(W[i,])
}
return(X)
}
