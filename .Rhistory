generate_binom=function(size,trials,p){
uni_matrix=matrix(runif(size*trials),nrow=size,ncol=trials)
bern_matrix=rowSums(uni_matrix<p)
generate_binom=sum(bern_matrix)
}
generate_binom(10,5,0.35)
