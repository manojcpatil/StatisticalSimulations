Regula_Falsi(a,b,f,err){
Regula_Falsi=function(a,b,f,err){
x=b-f(b)*(b-a)/(f(b)-f(a))
d2=data.frame("a"=a,"b"=b,"fa"=f(a),"fb"=f(b),"x"=x,"fx"=f(x))
while(abs(f(x))>err){
if(f(x)*f(b)<0){
a=x
}else{b=x}
x=b-f(b)*(b-a)/(f(b)-f(a))
d2=rbind(d2,c(a,b,f(a),f(b),x,f(x)))
}
return(d2)
}
