Newton_Raphson=function(f,df,x,err){
x1=x-f(x)/df(x)
x1
d=data.frame("Xn"=x,"fxn"=f(x),"dfxn"=df(x),"Xn1"=x1,"fXn1"=f(x1))
while(abs(x-x1) > err){
x=x1
x1=x-f(x)/df(x)
d=rbind(d,c(x,f(x),df(x),x1,f(x1)))
}
return (d)
}
